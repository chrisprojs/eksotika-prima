generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  productId Int       @id @default(autoincrement())
  title     String
  merk      String
  produsen  String
  detail    String
  variants  Variant[]
}

model Variant {
  variantId  Int     @id @default(autoincrement())
  size       String
  picture    String
  fromPrice  Int
  price      Int
  dozenPrice Int?
  productId  Int
  product    Product @relation(fields: [productId], references: [productId], onDelete: Cascade)
}
