generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  productId    Int           @id @default(autoincrement())
  title        String
  merk         String
  produsen     String
  detail       String
  variants     Variant[]
  newsProducts NewsProduct[]
}

model Variant {
  variantId  Int     @id @default(autoincrement())
  size       String
  picture    String
  fromPrice  Int
  price      Int
  dozenPrice Int?
  productId  Int
  product    Product @relation(fields: [productId], references: [productId], onDelete: Cascade)
}

model News {
  newsId      Int           @id @default(autoincrement())
  slug        String        @unique
  title       String
  category    String        @default("Education")
  summary     String
  contentHtml String
  coverImage  String?
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  products    NewsProduct[]
}

model NewsProduct {
  newsId    Int
  productId Int
  news      News    @relation(fields: [newsId], references: [newsId], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@id([newsId, productId])
}
